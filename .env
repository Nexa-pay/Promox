# ----------------------------------------------------
# Telegram API Credentials
# Get these from https://my.telegram.org/apps
# ----------------------------------------------------
API_ID=12345678
API_HASH=your_api_hash_here

# ----------------------------------------------------
# Bot Configuration
# Get this from @BotFather on Telegram
# ----------------------------------------------------
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ----------------------------------------------------
# Assistant Account Session
# Pyrogram String Session generated via OTP login
# ----------------------------------------------------
SESSION_STRING=your_long_pyrogram_string_session_here

# ----------------------------------------------------
# Bot Owner / Admin ID
# Your personal Telegram User ID (get from @Rose via /id)
# ----------------------------------------------------
OWNER_ID=123456789

# ----------------------------------------------------
# Database Connection
# MongoDB URI (MongoDB Atlas or Localhost)
# ----------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
